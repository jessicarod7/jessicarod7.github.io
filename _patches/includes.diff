diff '--color=auto' -Nru --color /minimal-mistakes-4.28.1/_includes/picture _includes/picture
--- /minimal-mistakes-4.28.1/_includes/picture	1969-12-31 19:00:00.000000000 -0500
+++ _includes/picture	2026-10-13 12:08:32.231000000 -0400
@@ -0,0 +1,17 @@
+{% assign picture = page.pictures[include.id] %}
+{% capture asset_dir %}/assets/img/{{ page.date | date: "%Y/%m" }}/{% endcapture %}
+
+<figure>
+  <picture>
+    {% for img in picture.srcset %}
+      <source srcset="{{ asset_dir }}{{ img }}">
+    {% endfor %}
+    <img src="{{ asset_dir }}{{ picture.fallback }}" alt="{{ picture.alt }}"
+      {% if picture.title %}
+         title="{{ picture.title }}"
+      {% endif %}>
+  </picture>
+  {% if picture.caption %}
+    <figcaption>{{ picture.caption }}</figcaption>
+  {% endif %}
+</figure>
\ No newline at end of file
